--!strict
-- Настройки RTS-камеры. Углы в градусах, расстояния в студах, скорости в секунду.

return {
	startZoom = 120, -- начальное расстояние от камеры до точки фокуса
	minZoom = 25,
	maxZoom = 400,
	zoomStep = 0.12, -- доля текущего расстояния за один щелчок колеса

	startPitch = 55, -- наклон: 90 = строго сверху
	minPitch = 25,
	maxPitch = 85,
	startYaw = 45,

	panSpeed = 1.2, -- скорость сдвига клавишами, в долях текущего расстояния
	keyRotateSpeed = 90, -- поворот клавишами Q/E
	mouseRotateSpeed = 0.3, -- градусов на пиксель при вращении правой кнопкой
	touchPanFactor = 1.0, -- множитель сдвига пальцем
	smoothing = 12, -- чем больше, тем резче камера догоняет цель
}
