--!strict
-- Население (этап 2). Жителей считаем по домам, а не поштучно.
-- Вместимость каждого дома — поле residents в Config/Buildings.

return {
	workerShare = 0.6, -- доля жильцов, которые работают
	walkRadius = 24, -- в скольких клетках от дома (между краями зданий) можно работать
	moveInPerSecond = 0.25, -- сколько жильцов в секунду въезжает в дом со свободными местами
	allocateSeconds = 2, -- как часто заново распределять рабочих по зданиям

	-- Еда и довольство (шаг 2). Довольство — от 0 до 100.
	foodPerResidentPerSecond = 1 / 600, -- 10 жильцов съедают 1 продукт в минуту
	shopRadius = 20, -- в скольких клетках от дома (между краями) должен быть магазин
	startHappiness = 100, -- довольство нового дома: время наладить еду
	happinessRatePerSecond = 0.2, -- с такой скоростью довольство идёт к цели (100 → 0 за ~8 минут)
	fedHappiness = 100, -- цель для сытого дома
	hungryHappiness = 0, -- цель для голодного
	growMinHappiness = 50, -- ниже этого новые жильцы не въезжают
	leaveBelowHappiness = 25, -- ниже этого жильцы уезжают
	leavePerSecond = 0.1, -- сколько жильцов в секунду уезжает из несчастного дома
	leaveFloorShare = 0.3, -- столько жильцов (доля вместимости) остаётся даже в несчастном доме
}
